POSTGRES_USER=kiraisoft
POSTGRES_PASSWORD=genera-un-secreto-largo-y-unico
POSTGRES_DB=kiraisoft

# Usa el hostname interno postgres-container en Docker Compose.
# Si la contraseña contiene caracteres especiales, codifícala para URL.
DATABASE_URL=postgresql+psycopg://kiraisoft:genera-un-secreto-largo-y-unico@postgres-container:5432/kiraisoft
JWT_SECRET_KEY=genera-un-secreto-de-al-menos-32-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Client ID de OAuth 2.0 tipo Web creado en Google Cloud.
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# Orígenes permitidos separados por comas.
CORS_ORIGINS=https://www.tudominio.com,https://tudominio.com

# Déjalo vacío si frontend y API comparten el mismo dominio.
VITE_API_URL=
