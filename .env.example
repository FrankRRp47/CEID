POSTGRES_USER=kiraisoft
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE_POR_UNA_SEGURA
POSTGRES_DB=kiraisoft

# La contraseña debe coincidir con POSTGRES_PASSWORD.
# Codifica caracteres especiales dentro de la URL si los utilizas.
DATABASE_URL=postgresql+psycopg://kiraisoft:CAMBIA_ESTA_CLAVE_POR_UNA_SEGURA@postgres-container:5432/kiraisoft

JWT_SECRET_KEY=CAMBIA_ESTE_SECRETO_POR_UNO_ALEATORIO_DE_32_CARACTERES
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Usa el mismo Client ID en ambas variables.
GOOGLE_CLIENT_ID=123456789012-abc123def456.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=123456789012-abc123def456.apps.googleusercontent.com

# Dominios exactos separados por comas, sin barra final.
CORS_ORIGINS=https://tudominio.com,https://www.tudominio.com

# Vacío porque Nginx sirve el frontend y reenvía /api al backend.
VITE_API_URL=
